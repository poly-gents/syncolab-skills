# Normalize line endings to LF in the repo; convert to LF in the working tree
# on every platform (modern editors on Windows/Mac/Linux all handle LF fine).
* text=auto eol=lf

# Shell scripts must stay LF or they fail on Linux/containers with:
# "bad interpreter: No such file or directory"
*.sh text eol=lf

# Windows-native scripts: keep CRLF, cmd.exe expects it.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
